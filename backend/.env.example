# ==========================================
# SafeOut Backend Environment Variables
# ==========================================

# Server port (default: 3000)
PORT=3000

# Node environment (development / production)
NODE_ENV=development

# ------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# ------------------------------------------
# Replace with your Supabase Postgres connection string.
# In Supabase dashboard: Project Settings -> Database -> Connection string -> URI
# NOTE for Supabase: Use transaction pooler (port 6543) or direct connection (port 5432).
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Used by node-pg-migrate (can be identical to DATABASE_URL or direct connection on port 5432)
MIGRATION_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional SSL override: require (automatically enabled if host is supabase.co or sslmode=require is in URL)
PGSSLMODE=require

# ------------------------------------------
# Authentication
# ------------------------------------------
# Secret key used for signing JWT tokens for dispatchers and superadmins
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ------------------------------------------
# Supabase API (Optional / Storage / Realtime)
# ------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
